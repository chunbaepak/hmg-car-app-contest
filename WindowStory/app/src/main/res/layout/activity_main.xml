<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 동화풍 배경: 하늘, 언덕, 길, 자동차, 이야기꾼 여우 -->
    <com.changbak.story.ui.SceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 왼쪽 위: 지금 듣는 장 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chapterPill"
            android:layout_width="wrap_content"
            android:layout_height="156dp"
            android:background="@drawable/bg_glass_dark"
            android:gravity="center_vertical"
            android:minWidth="520dp"
            android:orientation="horizontal"
            android:paddingStart="44dp"
            android:paddingEnd="56dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_book" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chapterBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="54sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chapterLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="32sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_light"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ink"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 오른쪽 위: 도착까지 남은 분량, 메뉴 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="124dp"
            android:background="@drawable/bg_glass_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="48dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_flag" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/remainLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="도착까지"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/remainBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="시연 도구"
            android:padding="28dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <!-- 말풍선: 낭독 자막과 창밖 퀘스트 -->
    <LinearLayout
        android:layout_width="820dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="250dp"
        android:layout_marginTop="270dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="34dp"
            android:paddingEnd="44dp"
            android:paddingBottom="34dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_book"
                    android:tint="@color/pink" />

                <TextView
                    android:id="@+id/lineText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="8"
                    android:minHeight="96dp"
                    android:textColor="@color/ink"
                    android:textSize="36sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/questBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="창밖 퀘스트! 찾으면 말해 줘"
                    android:textColor="@color/pink_dark"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/questButton"
                    style="@style/PinkButton"
                    android:layout_width="220dp"
                    android:layout_height="84dp"
                    android:text="찾았어!" />
            </LinearLayout>
        </LinearLayout>

        <!-- 말풍선 꼬리: 여우 쪽을 가리킨다 -->
        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="96dp"
            android:layout_marginTop="-30dp"
            android:background="@color/cream"
            android:elevation="8dp"
            android:rotation="45" />
    </LinearLayout>

    <!-- 오른쪽: 아이가 누르는 둥근 버튼 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="44dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/askButton"
            style="@style/RoundButton"
            android:contentDescription="얼마나 남았어?"
            android:src="@drawable/ic_clock" />

        <ImageButton
            android:id="@+id/micButton"
            style="@style/RoundButton"
            android:contentDescription="말하기"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/musicButton"
            style="@style/RoundButton"
            android:contentDescription="음악 취향"
            android:src="@drawable/ic_music" />
    </LinearLayout>

    <!-- 아래: 오늘의 이야기와 출발 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="430dp"
        android:layout_marginEnd="190dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/thumb_story" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_music"
            android:tint="@color/purple" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/storyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/storySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ink_soft"
                android:textSize="24sp" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="84dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="24dp"
            android:background="#33A0A6C0" />

        <Button
            android:id="@+id/startButton"
            style="@style/PinkButton"
            android:layout_width="250dp"
            android:layout_height="100dp"
            android:text="시연 출발" />
    </LinearLayout>

    <!-- 시연 도구(메뉴 버튼으로 열고 닫음) -->
    <LinearLayout
        android:id="@+id/demoPanel"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="176dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시연 도구"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/speedButton"
            style="@style/ChoiceButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/beltButton"
            style="@style/ChoiceButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxLines="3"
            android:textColor="@color/ink_soft"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 음악 취향 설정(정차 중에만 열림) -->
    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C2B3350"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="1240dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card"
            android:elevation="16dp"
            android:orientation="vertical"
            android:padding="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이가 좋아하는 음악"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="고른 특징에 맞는 분위기의 테마곡을 들려줘요."
                android:textColor="@color/ink_soft"
                android:textSize="24sp" />

            <TextView style="@style/SettingLabel" android:text="분위기" />
            <LinearLayout android:id="@+id/moodRow" style="@style/SettingRow" />

            <TextView style="@style/SettingLabel" android:text="빠르기" />
            <LinearLayout android:id="@+id/tempoRow" style="@style/SettingRow" />

            <TextView style="@style/SettingLabel" android:text="악기" />
            <LinearLayout android:id="@+id/instrumentRow" style="@style/SettingRow" />

            <TextView style="@style/SettingLabel" android:text="Suno 생성 요청문" />
            <TextView
                android:id="@+id/promptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/ink"
                android:textSize="21sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="지금은 분위기별로 미리 넣어 둔 곡을 틀어요. 빠르기와 악기는 요청문에만 반영돼요."
                android:textColor="@color/ink_soft"
                android:textSize="20sp" />

            <Button
                android:id="@+id/settingsClose"
                style="@style/PinkButton"
                android:layout_width="260dp"
                android:layout_height="88dp"
                android:layout_gravity="end"
                android:layout_marginTop="24dp"
                android:text="완료" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
