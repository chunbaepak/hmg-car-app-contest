<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundButton">
        <item name="android:layout_width">108dp</item>
        <item name="android:layout_height">108dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:background">@drawable/bg_round</item>
        <item name="android:tint">@color/ink</item>
        <item name="android:padding">28dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ChoiceButton">
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:textColor">@color/text_choice</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PinkButton">
        <item name="android:background">@drawable/bg_pill_pink</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
